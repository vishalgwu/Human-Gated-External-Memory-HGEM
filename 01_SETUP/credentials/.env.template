# HGEM local environment template
# Copy this file to `.env` locally and fill real values there.
# Do not commit `.env`.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_TEMPERATURE=0.0

# PostgreSQL: T1 immutable store + experiment logs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hgem_research
POSTGRES_USER=hgem_app
POSTGRES_PASSWORD=

# Neo4j: T2 validated memory graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Redis: T3 ephemeral rolling buffer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ChromaDB: measurement index only, not retrieval context for HGEM
CHROMA_PERSIST_DIRECTORY=03_SYSTEM/database/chromadb/chroma_store

# Experiment paths
HGEM_SESSION_DATA_DIR=04_EXPERIMENT/sessions
HGEM_ANALYSIS_READY_DIR=05_DATA/analysis_ready
HGEM_RANDOM_SEED=

# Runtime
LOG_LEVEL=INFO

